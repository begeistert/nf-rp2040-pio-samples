<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NanoSymbolsNamespace>Fade.Integration.Tests</NanoSymbolsNamespace>
    <NanoSymbolsClassName>AppSymbols</NanoSymbolsClassName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- RP2040 emulator + nanoFramework test kit (boot the nanoCLR, walk managed state, check
         checksums) + the NanoSymbols generator. BUSL-1.1 — the samples and the PIO library are MIT. -->
  </ItemGroup>

  <ItemGroup>
    <NanoFrameworkApp Include="..\..\src\Fade.Sample\Fade.Sample.nfproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\firmware\*.*" Link="firmware\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="StageNanoDeployment" AfterTargets="_NanoFrameworkBuildApps" BeforeTargets="Build">
    <ItemGroup>
      <_Pe Include="..\..\tools\nf\corelib\mscorlib.pe" />
      <_Pe Include="..\..\tools\lib\nanoFramework.Runtime.Events.pe" />
      <_Pe Include="..\..\src\Fade.Sample\bin\Release\nanoFramework.Hardware.Pico.pe" />
      <_Pe Include="..\..\src\Fade.Sample\bin\Release\Fade.Sample.pe" />
    </ItemGroup>
    <Copy SourceFiles="@(_Pe)" DestinationFolder="$(OutDir)pe" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\..\RP2350Sharp\src\RP2350Sharp.NanoFramework.TestKit\RP2350Sharp.NanoFramework.TestKit.csproj" />
    <ProjectReference Include="..\..\..\RP2040Sharp\src\RP2040Sharp.NanoFramework.TestKit.SourceGen\RP2040Sharp.NanoFramework.TestKit.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\..\RP2040Sharp\src\RP2040Sharp.NanoFramework.TestKit\build\RP2040Sharp.NanoFramework.TestKit.targets" />

</Project>
