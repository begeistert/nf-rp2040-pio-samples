<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NanoSymbolsNamespace>Dht.Integration.Tests</NanoSymbolsNamespace>
    <NanoSymbolsClassName>AppSymbols</NanoSymbolsClassName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- STEP 3 (TEMPORARY, UNCOMMITTED): use the LOCAL fixed RP2040Sharp emulator (OnRxPush fix active)
         via ProjectReference instead of the NuGet, so the DMA RX-DREQ path closes in-harness. Revert to
         the PackageReference once a fixed RP2040Sharp.NanoFramework.TestKit NuGet is released. -->
  </ItemGroup>

  <ItemGroup>
    <NanoFrameworkApp Include="..\..\src\Dht.Sample\Dht.Sample.nfproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\firmware\*.*" Link="firmware\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="StageNanoDeployment" AfterTargets="_NanoFrameworkBuildApps" BeforeTargets="Build">
    <ItemGroup>
      <_Pe Include="..\..\tools\nf\corelib\mscorlib.pe" />
      <_Pe Include="..\..\tools\lib\nanoFramework.Runtime.Events.pe" />
      <_Pe Include="..\..\src\Dht.Sample\bin\Release\nanoFramework.Hardware.Pico.pe" />
      <_Pe Include="..\..\src\Dht.Sample\bin\Release\Dht.Sample.pe" />
    </ItemGroup>
    <Copy SourceFiles="@(_Pe)" DestinationFolder="$(OutDir)pe" SkipUnchangedFiles="true" />
  </Target>

  <!-- STEP 3 (TEMPORARY, UNCOMMITTED): the NuGet's build/ targets aren't brought by a ProjectReference,
       so import them explicitly to keep the nanoFramework app build wiring. -->

  <ItemGroup>
    <ProjectReference Include="..\..\..\RP2350Sharp\src\RP2350Sharp.NanoFramework.TestKit\RP2350Sharp.NanoFramework.TestKit.csproj" />
    <ProjectReference Include="..\..\..\RP2040Sharp\src\RP2040Sharp.NanoFramework.TestKit.SourceGen\RP2040Sharp.NanoFramework.TestKit.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\..\RP2040Sharp\src\RP2040Sharp.NanoFramework.TestKit\build\RP2040Sharp.NanoFramework.TestKit.targets" />

</Project>
