<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 runs each test project as a normal executable via Microsoft.Testing.Platform,
         NOT the vstest testhost — which is what made the CPU-bound emulator ~50x slower. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- RP2350 (Cortex-M33) emulator + nanoFramework test kit: boot the nanoCLR, walk managed state,
         check checksums. The RP2350 twin runs the M33 firmware the RP2040 (M0+) kit could not decode. -->
  </ItemGroup>

  <ItemGroup>
    <NanoFrameworkApp Include="..\..\src\Blink.Sample\Blink.Sample.nfproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\firmware\*.*" Link="firmware\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Stage the prebuilt deployment (.pe) next to the test. Rebuild the Blink.Sample.nfproj with the
       nanoFramework build first if the assemblies changed. -->
  <Target Name="StageNanoDeployment" BeforeTargets="Build">
    <ItemGroup>
      <_Pe Include="..\..\tools\nf\corelib\mscorlib.pe" />
      <_Pe Include="..\..\tools\lib\nanoFramework.Runtime.Events.pe" />
      <_Pe Include="..\..\src\Blink.Sample\bin\Release\nanoFramework.Hardware.Pico.pe" />
      <_Pe Include="..\..\src\Blink.Sample\bin\Release\Blink.Sample.pe" />
    </ItemGroup>
    <Copy SourceFiles="@(_Pe)" DestinationFolder="$(OutDir)pe" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\..\RP2350Sharp\src\RP2350Sharp.NanoFramework.TestKit\RP2350Sharp.NanoFramework.TestKit.csproj" />
    <ProjectReference Include="..\..\..\RP2040Sharp\src\RP2040Sharp.NanoFramework.TestKit.SourceGen\RP2040Sharp.NanoFramework.TestKit.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\..\RP2040Sharp\src\RP2040Sharp.NanoFramework.TestKit\build\RP2040Sharp.NanoFramework.TestKit.targets" />

</Project>
